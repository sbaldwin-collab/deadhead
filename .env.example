# Copy to .env for local runs. On a host, set these as environment variables.

# Public URL used in emails and Stripe redirects. Optional: defaults to the address visitors use.
BASE_URL=
PORT=8080

# SQLite database file. In production put it on a persistent disk (e.g. /data/deadhead.db).
DATABASE_FILE=./data/deadhead.db

# Comma-separated emails that get the Desk (admin) role. If empty, the first account to sign up becomes admin.
ADMIN_EMAILS=you@yourcompany.com

BRAND_NAME=Deadhead
SUPPORT_EMAIL=help@yourdomain.com
SUPPORT_PHONE=

# Service fee added on top of the operator's price, in percent. 0 disables it.
PLATFORM_FEE_PCT=5
# Hours an operator has to confirm before the request expires and the card hold is released.
CONFIRM_WINDOW_HOURS=48

# Stripe (leave blank to run in request mode: no card payment, the desk invoices).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via Resend (leave blank to log emails instead of sending).
RESEND_API_KEY=
EMAIL_FROM=Deadhead <bookings@yourdomain.com>

# Set to 1 when running behind a load balancer/proxy that sets X-Forwarded-For (Render, Fly, Railway).
TRUST_PROXY=1

# Optional secret mixed into password hashes. Set before the first signup and never change it.
PASSWORD_PEPPER=
